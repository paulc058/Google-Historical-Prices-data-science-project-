import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import scipy.stats as stats
import os

# Fallback data parser to reconstruct 'cleaned_df' from the uploaded PDF
def parse_pdf_data(pdf_path):
    try:
        import pdfplumber
    except ImportError:
        import subprocess
        subprocess.run(["pip", "install", "pdfplumber"], stdout=subprocess.DEVNULL)
        import pdfplumber

    all_rows = []
    with pdfplumber.open(pdf_path) as pdf:
        for page in pdf.pages:
            table = page.extract_table()
            if table:
                all_rows.extend(table)

    raw_df = pd.DataFrame(all_rows)

    # Dynamically find the row that contains 'Date'
    header_idx = None
    for idx, row in raw_df.iterrows():
        if any(isinstance(val, str) and 'Date' in val for val in row.values):
            header_idx = idx
            break

    if header_idx is None:
        # Fallback to standard index 2 if 'Date' string isn't found explicitly
        header_idx = 2

    headers = raw_df.iloc[header_idx].values
    cleaned_df = raw_df.iloc[header_idx + 1:].copy()
    cleaned_df.columns = headers
    cleaned_df = cleaned_df.dropna(subset=['Date'])
    cleaned_df['Date'] = pd.to_datetime(cleaned_df['Date'])
    cleaned_df = cleaned_df.sort_values('Date')
    numeric_cols = ['Open', 'High', 'Low', 'Close', 'Adj Close', 'Volume']
    for col in numeric_cols:
        cleaned_df[col] = cleaned_df[col].astype(str).str.replace(',', '')
        cleaned_df[col] = pd.to_numeric(cleaned_df[col], errors='coerce')
    cleaned_df = cleaned_df.dropna(subset=['Close', 'Volume'])
    return cleaned_df

# Ensure we have our sorted time series dataset
if 'cleaned_df' in globals():
    analysis_df = cleaned_df.set_index('Date').sort_index().copy()
else:
    # Locate the uploaded PDF
    pdf_files = [f for f in os.listdir('/content') if f.endswith('.pdf')]
    if pdf_files:
        pdf_path = os.path.join('/content', pdf_files[0])
        cleaned_df = parse_pdf_data(pdf_path)
        analysis_df = cleaned_df.set_index('Date').sort_index().copy()
    else:
        raise FileNotFoundError("Please upload the 'Google dataset Historical prices 2026 - Sheet1.pdf' using cell mgwPGp4E0YKM first.")

# =========================================================================
# Formula 1: Bollinger Bands (Volatility & Mean-Reversion Patterns)
# =========================================================================
period = 20
analysis_df['Middle_Band'] = analysis_df['Close'].rolling(window=period).mean()
analysis_df['Std_Dev'] = analysis_df['Close'].rolling(window=period).std()
analysis_df['Upper_Band'] = analysis_df['Middle_Band'] + (2 * analysis_df['Std_Dev'])
analysis_df['Lower_Band'] = analysis_df['Middle_Band'] - (2 * analysis_df['Std_Dev'])

# =========================================================================
# Formula 2: Daily Log Returns (Distribution & Return Patterns)
# =========================================================================
analysis_df['Log_Returns'] = np.log(analysis_df['Close'] / analysis_df['Close'].shift(1))

# Plotting the analytical charts
fig, axes = plt.subplots(2, 1, figsize=(14, 12))

# Chart 1: Bollinger Bands
axes[0].plot(analysis_df.index, analysis_df['Close'], label='Close Price', color='royalblue', linewidth=1.5)
axes[0].plot(analysis_df.index, analysis_df['Middle_Band'], label='20-day SMA (Middle Band)', color='darkorange', linestyle='--')
axes[0].plot(analysis_df.index, analysis_df['Upper_Band'], label='Upper Band (+2 SD)', color='forestgreen', alpha=0.7)
axes[0].plot(analysis_df.index, analysis_df['Lower_Band'], label='Lower Band (-2 SD)', color='crimson', alpha=0.7)
axes[0].fill_between(analysis_df.index, analysis_df['Lower_Band'], analysis_df['Upper_Band'], color='gray', alpha=0.1, label='Volatility Range')
axes[0].set_title('Statistical Pattern: Bollinger Bands Volatility Channels', fontsize=14, fontweight='bold')
axes[0].set_ylabel('Stock Price ($)', fontsize=12)
axes[0].legend(loc='upper right')
axes[0].grid(True, linestyle=':', alpha=0.6)

# Chart 2: Distribution of Log Returns
sns.histplot(analysis_df['Log_Returns'].dropna(), kde=True, ax=axes[1], color='purple', bins=40, stat='density', label='Log Returns Distribution')

# Overlap a theoretical normal distribution for visual statistical comparison
mu, std = stats.norm.fit(analysis_df['Log_Returns'].dropna())
x_range = np.linspace(analysis_df['Log_Returns'].min(), analysis_df['Log_Returns'].max(), 100)
axes[1].plot(x_range, stats.norm.pdf(x_range, mu, std), 'r--', linewidth=2, label=f'Normal Fit (μ={mu:.4f}, σ={std:.4f})')

# Calculate Skewness and Kurtosis
skew = stats.skew(analysis_df['Log_Returns'].dropna())
kurt = stats.kurtosis(analysis_df['Log_Returns'].dropna())

axes[1].set_title(f'Statistical Pattern: Distribution of Returns (Skewness: {skew:.2f}, Kurtosis: {kurt:.2f})', fontsize=14, fontweight='bold')
axes[1].set_xlabel('Daily Log Return', fontsize=12)
axes[1].set_ylabel('Density', fontsize=12)
axes[1].legend(loc='upper left')
axes[1].grid(True, linestyle=':', alpha=0.6)

plt.tight_layout()
plt.show()
